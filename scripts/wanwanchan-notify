#!/bin/sh
# Tells WanWan-chan what an AI agent is doing. Safe to call when WanWan-chan is not running.
# usage: wanwanchan-notify <agent> <event|state> [extra args are ignored]
# states: idle | thinking | working | waiting | completed | error
PORT="${WANWANCHAN_PORT:-47321}"
curl -s -m 1 -X POST "http://127.0.0.1:${PORT}/event?agent=$1&event=$2" >/dev/null 2>&1 || true
exit 0
