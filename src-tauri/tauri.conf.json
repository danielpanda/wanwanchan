{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WanWan-chan",
  "version": "0.2.2",
  "identifier": "com.wanwanchan.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Entertainment",
    "shortDescription": "A lightweight pixel pet for your macOS desktop",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "dmg": {
        "windowSize": { "width": 540, "height": 360 },
        "appPosition": { "x": 140, "y": 170 },
        "applicationFolderPosition": { "x": 400, "y": 170 }
      }
    }
  }
}
